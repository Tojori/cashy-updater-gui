#!/bin/bash
# Test-Double für cachy-update/arch-update. Bildet Ausgabeformat, Abfragen,
# Statusdateien und Exit-Codes von arch-update 4.4.x nach (C-Locale).
# Führt KEINE Systemänderungen aus. Steuerung über Umgebungsvariablen:
#   FAKE_SCENARIO = success | integrity | none | check_network
#   FAKE_DELAY    = Pause zwischen Schritten in Sekunden (Standard 0)
#   FAKE_REBOOT   = 1 → Kernel-Neustart-Abfrage
#   FAKE_PASSWORD = erwartetes sudo-Passwort (Standard "secret")
name="arch-update"
statedir="${XDG_STATE_HOME:-${HOME}/.local/state}/${name}"
config_file="${XDG_CONFIG_HOME:-${HOME}/.config}/${name}/${name}.conf"
scenario="${FAKE_SCENARIO:-success}"
delay="${FAKE_DELAY:-0}"
mkdir -p "${statedir}"

bold="\e[1m"; blue="${bold}\e[34m"; green="${bold}\e[32m"; yellow="${bold}\e[33m"; red="${bold}\e[31m"; off="\e[0m"
main_msg() { echo -e "${blue}==>${off}${bold} ${1}${off}"; }
info_msg() { echo -e "${green}==>${off}${bold} ${1}${off}"; }
warning_msg() { echo -e "${yellow}==> WARNING:${off}${bold} ${1}${off}"; }
error_msg() { echo -e >&2 "${red}==> ERROR:${off}${bold} ${1}${off}"; }
ask_msg() { read -rp "$(echo -e "${blue}->${off}${bold} ${1}${off} ")" answer; }
quit_msg() { read -n 1 -r -s -p "$(info_msg "Press \"enter\" to quit ")" && echo; }
pause() { sleep "${delay}"; }

packages() {
	[ "${scenario}" = "none" ] && return
	printf 'linux 6.17.1.arch1-1 -> 6.17.2.arch1-1\nmesa 1:25.2.4-1 -> 1:25.2.5-1\n'
}

case "${1}" in
	-V|--version) echo "${name} 9.9.9-test" ;;
	-c|--check)
		if [ "${2}" = "--enable" ]; then
			[ -n "${FAKE_TIMER_STATE}" ] && echo enabled > "${FAKE_TIMER_STATE}"
			info_msg "Automated update checks have been enabled"
			exit 0
		fi
		pause
		if [ "${scenario}" = "check_network" ]; then
			echo "==> ERROR: Cannot fetch updates" >&2
			: > "${statedir}/last_updates_check_packages"
		else
			packages > "${statedir}/last_updates_check_packages"
		fi
		echo "paru-git 1.0-1 -> 1.1-1" > "${statedir}/last_updates_check_aur"
		[ "${scenario}" = "none" ] && : > "${statedir}/last_updates_check_aur"
		: > "${statedir}/last_updates_check_flatpak"
		date "+%s%n%F %T" > "${statedir}/last_updates_check_time"
		;;
	-n|--news)
		info_msg "Looking for recent Arch News..."
		echo
		main_msg "Arch News:"
		echo "1 - Mkinitcpio >=42 requires manual intervention"
		echo "2 - Valkey to replace Redis"
		echo
		ask_msg "Select the news to read (e.g. 1 3 5), select 0 to read them all or press \"enter\" to quit:"
		;;
	--gen-config)
		mkdir -p "$(dirname "${config_file}")"
		printf '#NoColor\n#NoAUR\n#NewsNum=5\n#AURHelper=paru\n' > "${config_file}"
		info_msg "The '${config_file}' configuration file has been generated"
		;;
	""|-d|--devel)
		exec {fd}> "${XDG_RUNTIME_DIR:-/tmp}/fake-arch-update-${UID}.lock"
		info_msg "Looking for updates...\n"
		pause
		pk=$(packages)
		if [ -z "${pk}" ]; then
			info_msg "No update available\n"
			main_msg "Packages cache:"
			info_msg "No old package archive found\n"
			quit_msg
			exit 0
		fi
		main_msg "Packages:"
		echo "${pk}"
		echo
		ask_msg "Proceed with update? [Y/n]"
		case "${answer}" in
			Y|y|"") echo ;;
			*) echo; error_msg "The update has been aborted\n"; quit_msg; exit 4 ;;
		esac
		info_msg "Looking for recent Arch News..."
		echo; info_msg "No recent Arch News found"
		pause
		echo; main_msg "Updating Packages...\n"
		read -rsp "[sudo] password for tester: " pw; echo
		if [ "${pw}" != "${FAKE_PASSWORD:-secret}" ]; then
			echo "sudo: 1 incorrect password attempt"
			echo; error_msg "An error has occurred during the update process\nThe update has been aborted\n"; quit_msg
			exit 5
		fi
		echo ":: Synchronizing package databases..."
		printf " core downloading...\r core is up to date\n"
		echo ":: Starting full system upgrade..."
		echo "resolving dependencies..."
		echo
		echo "Packages (2) linux-6.17.2.arch1-1  mesa-1:25.2.5-1"
		echo
		read -rp ":: Proceed with installation? [Y/n] " a
		[ "${a}" = "n" ] && exit 5
		echo ":: Retrieving packages..."
		for p in 25 60 100; do printf " Total ( 1/2)    150.0 MiB  9.00 MiB/s 00:10 [####----] %3d%%\r" "${p}"; pause; done; echo
		for p in 50 100; do printf "(2/2) checking keys in keyring                     [######----] %3d%%\r" "${p}"; pause; done; echo
		printf "(2/2) checking package integrity                   [##########] 100%%\n"
		if [ "${scenario}" = "integrity" ]; then
			echo "error: linux: signature from \"Test Packager <t@example.org>\" is unknown trust"
			echo ":: File /var/cache/pacman/pkg/linux-6.17.2.arch1-1-x86_64.pkg.tar.zst is corrupted (invalid or corrupted package (PGP signature))."
			echo "error: failed to commit transaction (invalid or corrupted package)"
			echo; error_msg "An error has occurred during the update process\nThe update has been aborted\n"; quit_msg
			exit 5
		fi
		printf "(2/2) loading package files                        [##########] 100%%\n"
		printf "(2/2) checking for file conflicts                  [##########] 100%%\n"
		echo ":: Processing package changes..."
		for i in 1 2; do
			for p in 30 100; do printf "(%d/2) upgrading pkg%d                           [######----] %3d%%\r" "${i}" "${i}" "${p}"; pause; done; echo
		done
		echo ":: Running post-transaction hooks..."
		echo "(1/1) Arming ConditionNeedsUpdate..."
		: > "${statedir}/last_updates_check_packages"
		echo; info_msg "The update has been applied\n"
		date +%Y-%m-%d > "${statedir}/last_update_run"
		if [ "${FAKE_REBOOT:-0}" = "1" ]; then
			main_msg "Reboot required:\nThere's a pending kernel update on your system requiring a reboot to be applied\n"
			ask_msg "Would you like to reboot now? [y/N]"
			echo; warning_msg "The reboot hasn't been performed\nPlease, consider rebooting to finalize the pending kernel update\n"
		else
			info_msg "No pending kernel update found\n"
		fi
		info_msg "No service requiring a post upgrade restart found\n"
		quit_msg
		exit 0
		;;
	*) error_msg "Invalid option"; exit 1 ;;
esac
