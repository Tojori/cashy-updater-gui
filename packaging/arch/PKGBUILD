# PKGBUILD für Arch Linux / CachyOS – baut aus dem lokalen Quellbaum.
#   cd packaging/arch && makepkg -si
pkgname=cashy-updater-gui
pkgver=0.1.0
pkgrel=1
pkgdesc="Grafische Oberfläche für cachy-update (arch-update)"
arch=('x86_64')
url="https://github.com/CachyOS/cachy-update"
license=('unknown')
depends=('cachy-update' 'gcc-libs' 'glibc' 'fontconfig' 'freetype2' 'libxkbcommon'
         'wayland' 'libglvnd' 'libx11' 'libxcursor' 'libxi' 'libxkbcommon-x11')
optdepends=('xdg-utils: Logordner und Arch-News im Browser öffnen'
            'mesa: OpenGL/EGL-Treiber für die Hardware-Darstellung')
makedepends=('cargo')
options=('!lto')

_srcroot="$(cd "${startdir}/../.." && pwd)"

build() {
	cd "${_srcroot}"
	cargo build --release --locked --target-dir "${srcdir}/target"
}

check() {
	cd "${_srcroot}"
	# Debug-Profil: die GUI-Tests benötigen Slint-Element-Debuginfos (siehe build.rs).
	cargo test --locked --target-dir "${srcdir}/target"
}

package() {
	install -Dm755 "${srcdir}/target/release/cashy-updater-gui" "${pkgdir}/usr/bin/cashy-updater-gui"
	install -Dm644 "${_srcroot}/packaging/desktop/cashy-updater-gui.desktop" "${pkgdir}/usr/share/applications/cashy-updater-gui.desktop"
	install -Dm644 "${_srcroot}/packaging/desktop/cashy-updater-gui.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/cashy-updater-gui.svg"
}
