// Das Icon füllt in Layouts die Zeilenhöhe und zentriert den Pfad vertikal.
export component Icon {
    in property <string> name;
    in property <color> color: Theme.text;
    in property <length> size: 18px;
    width: size;
    min-height: size;
    Path {
        x: 0;
        y: (parent.height - root.size) / 2;
        width: root.size;
        height: root.size;
        commands: root.name;
        stroke: root.color;
        stroke-width: 1.8px;
        fill: transparent;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
    }
}
