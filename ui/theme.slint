// Designsystem: Farben, Abstände, Typografie und Icons.
// Dark Mode ist Standard; Light Mode wird über Theme.dark umgeschaltet.

export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #0f1218 : #f3f5f9;
    out property <color> sidebar: dark ? #131720 : #ffffff;
    out property <color> surface: dark ? #1a1f2a : #ffffff;
    out property <color> surface-2: dark ? #222836 : #eef1f6;
    out property <color> surface-hover: dark ? #283041 : #e4e8ef;
    out property <color> border: dark ? #2a3141 : #dce1e9;
    out property <color> text: dark ? #e8ecf3 : #182030;
    out property <color> text-muted: dark ? #9aa4b5 : #5a6475;
    out property <color> accent: dark ? #2cc3d6 : #0b8a9c;
    out property <color> accent-hover: dark ? #4fd3e3 : #097586;
    out property <color> on-accent: dark ? #062027 : #ffffff;
    out property <color> success: dark ? #34d399 : #047857;
    out property <color> warning: dark ? #fbbf24 : #b45309;
    out property <color> danger: dark ? #f87171 : #c81e1e;
    out property <color> focus: dark ? #93e2ee : #075e6b;
    out property <color> shadow: dark ? #00000080 : #1a20301f;
    out property <color> terminal-bg: dark ? #0b0e13 : #1b2130;
    out property <color> terminal-text: #d6dde8;

    out property <length> radius: 12px;
    out property <length> radius-sm: 8px;
    out property <length> pad: 20px;
    out property <length> gap: 16px;

    out property <length> font-small: 12px;
    out property <length> font-body: 14px;
    out property <length> font-h2: 16px;
    out property <length> font-title: 24px;

    // 0 neutral, 1 Erfolg, 2 Warnung, 3 Fehler, 4 beschäftigt
    public pure function tone-color(tone: int) -> color {
        if (tone == 1) {
            return self.success;
        }
        if (tone == 2) {
            return self.warning;
        }
        if (tone == 3) {
            return self.danger;
        }
        if (tone == 4) {
            return self.accent;
        }
        return self.text-muted;
    }
}

